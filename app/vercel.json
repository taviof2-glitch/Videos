{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/s/:t",
      "destination": "/api/seguimiento?t=:t"
    },
    {
      "source": "/g/:t",
      "destination": "/api/galeria?t=:t"
    },
    {
      "source": "/c/:t",
      "destination": "/api/cotizacion?t=:t"
    },
    {
      "source": "/((?!catalogo/|api/|s/|g/|c/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 14 * * *"
    }
  ]
}
